---
import '../styles/global.css';

const skills = [
  "JavaScript", 
  "TypeScript", 
  "React", 
  "Node.js", 
  "Angular", 
  "Python", 
  "Django", 
  "Java", 
  "Spring", 
  "MySQL", 
  "PostgreSQL", 
  "MongoDB", 
  "AWS", 
  "Docker", 
  "Git"
];

const projects = [
  {
    title: "AuraCore Software Solutions",
    description: "Founding ongoing software architecture and digital automation enterprise delivering scalable full-stack applications.",
    image: "/auracore.png",
    tags: ["Full-Stack", "Architecture", "Automation"]
  },
  {
    title: "NIMC Enrollment Platform",
    description: "Designed and built an enrollment application during tech support engineering engagements at Interra Networks.",
    image: "/nimc-platform.png",
    tags: ["Java", "Database Design", "Enrollment System"]
  },
  {
    title: "Software Solutions Engineering",
    description: "Ongoing core engineering relationship delivering custom software solutions for client enterprises.",
    image: "/software-solutions.png",
    tags: ["Python", "Django", "Node.js", "PostgreSQL"]
  }
];

const currentYear = new Date().getFullYear();
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Ameh Ebute | Full-Stack Developer & DPO</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700;800&display=swap" rel="stylesheet" />
  </head>
  <body>

    <header class="header">
      <div class="container nav-container">
        <a href="#" class="logo">Ameh Ebute</a>
        <ul class="nav-links">
          <li><a href="#about">About</a></li>
          <li><a href="#skills">Skills</a></li>
          <li><a href="#projects">Projects</a></li>
          <li><a href="#contact">Contact</a></li>
        </ul>
      </div>
    </header>

    <main class="container">
      <!-- Hero Section -->
      <section id="about" class="hero hero-grid">
        <div class="hero-content">
          <h1>Building <span>secure, performant</span> software & digital infrastructure.</h1>
          <p>
            Full-Stack Software Developer & Certified Data Protection Officer based in Abuja, Nigeria. 
            Specializing in building robust web applications, enterprise platforms, and compliant digital solutions.
          </p>
          <a href="#projects" class="cta-button">View Selected Work</a>
        </div>
        <div class="hero-image-wrapper">
          <img src="/hero-banner.png" alt="Ameh Ebute - Architecture & CDPO" class="hero-img" />
        </div>
      </section>

      <!-- Skills Section -->
      <section id="skills">
        <h2 class="section-title">Technical Expertise</h2>
        <div class="project-tags skills-wrapper">
          {skills.map((skill) => (
            <span class="tag skill-tag">{skill}</span>
          ))}
        </div>
      </section>

      <!-- Projects Section -->
      <section id="projects">
        <h2 class="section-title">Featured Work & Engagements</h2>
        <div class="projects-grid">
          {projects.map((project) => (
            <div class="project-card custom-card">
              <div class="card-img-wrapper">
                <img src={project.image} alt={project.title} class="card-img" />
              </div>
              <div class="project-info card-content">
                <h3 class="project-title card-title">{project.title}</h3>
                <p class="project-description">{project.description}</p>
                <div class="project-tags">
                  {project.tags.map((tag) => (
                    <span class="tag">{tag}</span>
                  ))}
                </div>
              </div>
            </div>
          ))}
        </div>
      </section>
    </main>

    <!-- Footer Section -->
    <footer id="contact" class="footer">
      <div class="container footer-container">
        <h2 class="section-title footer-title">Let's Connect</h2>
        <p class="footer-sub">
          Full-Stack Software Developer & Certified Data Protection Officer
        </p>

        <!-- Direct Contact Details -->
        <div class="footer-contact-info">
          <a href="mailto:seanameh@gmail.com" class="contact-item">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path><polyline points="22,6 12,13 2,6"></polyline></svg>
            <span>seanameh@gmail.com</span>
          </a>
          <span class="dot-divider">&bull;</span>
          <div class="contact-item">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path><circle cx="12" cy="10" r="3"></circle></svg>
            <span>Abuja, Nigeria</span>
          </div>
        </div>

        <!-- Social Media Links -->
        <div class="social-links">
          <a href="https://github.com" target="_blank" rel="noopener noreferrer" aria-label="GitHub" class="social-icon">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"></path></svg>
            <span>GitHub</span>
          </a>
          <a href="https://www.linkedin.com/in/ameh-ebute-1855852a0?utm_source=share_via&utm_content=profile&utm_medium=member_android" target="_blank" rel="noopener noreferrer" aria-label="LinkedIn" class="social-icon">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"></path><rect x="2" y="9" width="4" height="12"></rect><circle cx="4" cy="4" r="2"></circle></svg>
            <span>LinkedIn</span>
          </a>
          <a href="https://instagram.com/amehgram" target="_blank" rel="noopener noreferrer" aria-label="Instagram" class="social-icon">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line></svg>
            <span>Instagram</span>
          </a>
        </div>

        <p class="copyright">&copy; {currentYear} Ameh Ebute. All rights reserved.</p>
      </div>
    </footer>

  </body>
</html>
